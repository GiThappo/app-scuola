{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types",
      "vite/client"
    ],
    "lib": [
      "esnext"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test"
  ]
}